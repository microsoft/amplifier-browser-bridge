# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Secrets and local runtime state -- NEVER commit tokens or audit logs
.amplifier-browser-bridge/
tokens.json
*.token
amplifier-browser-bridge-audit.jsonl
audit*.jsonl
# Android CRX signing key (scripts/package-android.sh) -- defense in depth; the
# default location is already outside the repo (~/.config/...), this guards
# against AMPLIFIER_BROWSER_BRIDGE_ANDROID_SIGNING_KEY ever pointing inside it by mistake.
*.pem
# Baked Android hub URL/token (scripts/package-android.sh, android_bake.py) -- defense
# in depth; this file is only ever generated inside a temp build-stage directory
# outside the repo (see that script), this guards against it ever landing in
# extension/ (the tracked source tree) by mistake.
extension/bundled_config.json

# Editors / OS
.DS_Store
.vscode/
.idea/

# Node (extension has no build step today, but guard against future tooling)
node_modules/
